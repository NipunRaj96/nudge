# Copy to supabase/.env for local development (never commit real values).
# Send-SMS hook secret: any value in the format v1,whsec_<base64>.
SEND_SMS_HOOK_SECRET=
# Leave empty in dev: OTPs are printed in the edge-function log instead of sent.
SMS_URL_TEMPLATE=
# Road routes (OpenRouteService). Leave empty in dev: route lines stay straight.
ORS_API_KEY=
ORS_BASE_URL=
